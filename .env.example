# ==============================================================================
# NIFTY ATM ANALYZER - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (apps/web)
# Safe to expose in client browser bundle (prefixed with VITE_)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000/ws
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (apps/server)
# STRICTLY CONFIDENTIAL - Never expose in frontend or commit to version control
# ------------------------------------------------------------------------------
SERVER_PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database & Supabase Service Key (Bypasses RLS for secure server worker tasks)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# AES-256-GCM 32-byte hex key for encrypting user broker secrets at rest
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROKER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret for standalone/backend authenticated sessions
JWT_SECRET=super-secure-jwt-secret-key-change-in-production

# ------------------------------------------------------------------------------
# OPTIONAL DEPLOYMENT-WIDE BROKER CREDENTIALS
# Used as server fallback when user-specific credentials are not configured
# ------------------------------------------------------------------------------
# Angel One SmartAPI
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_KEY=

# Upstox V3 API
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:4000/api/brokers/upstox/callback
UPSTOX_ACCESS_TOKEN=
